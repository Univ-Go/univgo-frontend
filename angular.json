{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "univgo-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "es",
          "baseHref": "/es/"
        },
        "locales": {
          "en": {
            "translation": "src/locale/messages.en.xlf",
            "baseHref": "/en/"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["@angular/localize/init"],
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["src/app/core/theme"]
            },
            "i18nMissingTranslation": "error",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "*.svg",
                "input": "src/app/shared/brand",
                "output": "brand"
              },
              {
                "glob": "{arrow-left,arrow-right,ban,bell,book-open,calendar,calendar-check,calendar-clock,calendar-days,calendar-off,calendar-plus,calendar-search,calendar-x,check,chevron-down,chevron-left,chevron-right,chevrons-up-down,chevron-up,circle-alert,circle-check,circle-help,circle-pause,circle-plus,circle-slash,circle-user-round,circle-x,clock,code,copy,door-closed,door-closed-locked,electron,ellipsis,expand,eye,eye-off,file,filter,filter-x,flask-conical,grip-vertical,heart,heart-filled,history,hourglass,house,id-card,info,keyboard,layout-grid,link,loader-circle,lock,log-in,log-out,map-pin,map-pin-off,maximize-2,menu,minimize,minus,mir,moon,pencil,plus,qr-code,radio,refresh-cw,repeat,rotate-ccw,rotate-ccw-square,scan-line,scan-qr-code,search,search-x,settings,shield-check,shrink,sliders-horizontal,star,sun,switch-camera,timer-off,trash,triangle-alert,user,user-check,user-plus,users,user-x,video-off,visa,volleyball,wifi-off,wrench,x}.svg",
                "input": "node_modules/@taiga-ui/icons/src",
                "output": "assets/taiga-ui/icons"
              }
            ],
            "styles": ["node_modules/@taiga-ui/styles/taiga-ui-theme.less", "src/styles.scss"],
            "externalDependencies": ["fonts/*", "images/*"]
          },
          "configurations": {
            "production": {
              "localize": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "650kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "localize": ["es"],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "development-en": {
              "localize": ["en"],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "univgo-frontend:build:production"
            },
            "development": {
              "buildTarget": "univgo-frontend:build:development"
            },
            "development-en": {
              "buildTarget": "univgo-frontend:build:development-en"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "univgo-frontend:build:development",
            "outputPath": "src/locale",
            "outFile": "messages.xlf",
            "format": "xlf"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "univgo-frontend:build:development",
            "runner": "vitest",
            "setupFiles": ["src/test-setup.ts"],
            "coverageReporters": ["text-summary", "lcovonly"],
            "coverageExclude": [
              "src/main.ts",
              "src/**/*.spec.ts",
              "src/locale/**",
              "src/environments/**"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
