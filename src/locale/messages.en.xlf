      <trans-unit id="auth.login.brandLead" datatype="html">
        <source>Consulta la disponibilidad de canchas, salas de estudio y laboratorios, y confirma tu reserva desde cualquier dispositivo.</source>
        <target>Check the availability of courts, study rooms and labs, and confirm your booking from any device.</target>
      </trans-unit>
