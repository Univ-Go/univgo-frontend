<?xml version="1.0" encoding="UTF-8" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="es" target-language="en" datatype="plaintext" original="ng2.template">
    <body>
      <trans-unit id="error.network.summary" datatype="html">
        <source>Sin conexión</source>
        <target>No connection</target>
      </trans-unit>
      <trans-unit id="error.network.detail" datatype="html">
        <source>No hemos podido conectar con el servidor. Revisa tu conexión a internet e inténtalo de nuevo.</source>
        <target>We couldn't reach the server. Check your internet connection and try again.</target>
      </trans-unit>
      <trans-unit id="error.unauthorized.summary" datatype="html">
        <source>Sesión caducada</source>
        <target>Session expired</target>
      </trans-unit>
      <trans-unit id="error.unauthorized.detail" datatype="html">
        <source>Tu sesión ha caducado. Vuelve a iniciar sesión para continuar.</source>
        <target>Your session has expired. Sign in again to continue.</target>
      </trans-unit>
      <trans-unit id="error.forbidden.summary" datatype="html">
        <source>Sin permisos</source>
        <target>No permission</target>
      </trans-unit>
      <trans-unit id="error.forbidden.detail" datatype="html">
        <source>No tienes permiso para realizar esta acción. Si crees que se trata de un error, contacta con tu universidad.</source>
        <target>You don't have permission to do this. If you think this is a mistake, contact your university.</target>
      </trans-unit>
      <trans-unit id="error.notFound.summary" datatype="html">
        <source>No encontrado</source>
        <target>Not found</target>
      </trans-unit>
      <trans-unit id="error.notFound.detail" datatype="html">
        <source>No hemos encontrado la información que buscabas. Es posible que ya no esté disponible.</source>
        <target>We couldn't find the information you were looking for. It may no longer be available.</target>
      </trans-unit>
      <trans-unit id="error.conflict.summary" datatype="html">
        <source>La información ha cambiado</source>
        <target>The information has changed</target>
      </trans-unit>
      <trans-unit id="error.conflict.detail" datatype="html">
        <source>Otra persona se ha adelantado y los datos han cambiado. Actualiza la página e inténtalo de nuevo.</source>
        <target>Someone got there first and the data has changed. Refresh the page and try again.</target>
      </trans-unit>
      <trans-unit id="error.validation.summary" datatype="html">
        <source>Revisa los datos</source>
        <target>Check the details</target>
      </trans-unit>
      <trans-unit id="error.validation.detail" datatype="html">
        <source>Algunos datos no son correctos. Revísalos e inténtalo de nuevo.</source>
        <target>Some of the details aren't correct. Review them and try again.</target>
      </trans-unit>
      <trans-unit id="error.rateLimited.summary" datatype="html">
        <source>Demasiados intentos</source>
        <target>Too many attempts</target>
      </trans-unit>
      <trans-unit id="error.rateLimited.detail" datatype="html">
        <source>Has hecho muchas solicitudes seguidas. Espera unos segundos e inténtalo de nuevo.</source>
        <target>You've made too many requests in a row. Wait a few seconds and try again.</target>
      </trans-unit>
      <trans-unit id="error.server.summary" datatype="html">
        <source>Algo ha fallado</source>
        <target>Something went wrong</target>
      </trans-unit>
      <trans-unit id="error.server.detail" datatype="html">
        <source>Estamos teniendo un problema técnico. Inténtalo de nuevo en unos minutos.</source>
        <target>We're having a technical problem. Try again in a few minutes.</target>
      </trans-unit>
      <trans-unit id="error.unknown.summary" datatype="html">
        <source>Algo ha fallado</source>
        <target>Something went wrong</target>
      </trans-unit>
      <trans-unit id="error.unknown.detail" datatype="html">
        <source>No hemos podido completar la operación. Inténtalo de nuevo.</source>
        <target>We couldn't complete the operation. Try again.</target>
      </trans-unit>
      <trans-unit id="error.reference" datatype="html">
        <source>Referencia: <x id="reference" equiv-text="reference"/></source>
        <target>Reference: <x id="reference" equiv-text="reference"/></target>
      </trans-unit>
      <trans-unit id="auth.login.pageTitle" datatype="html">
        <source>Inicia sesión</source>
        <target>Sign in</target>
      </trans-unit>
      <trans-unit id="auth.login.pageDescription" datatype="html">
        <source>Accede con las credenciales de tu universidad para reservar espacios deportivos y de estudio.</source>
        <target>Sign in with your university credentials to book sports and study spaces.</target>
      </trans-unit>
      <trans-unit id="auth.login.skipToForm" datatype="html">
        <source>Saltar al formulario</source>
        <target>Skip to the form</target>
      </trans-unit>
      <trans-unit id="auth.login.brandBadge" datatype="html">
        <source>Portal oficial de reservas</source>
        <target>Official booking portal</target>
      </trans-unit>
      <trans-unit id="auth.login.brandTitle" datatype="html">
        <source>Reserva los espacios de tu universidad en segundos.</source>
        <target>Book your university spaces in seconds.</target>
      </trans-unit>
      <trans-unit id="auth.login.brandLead" datatype="html">
        <source>Consulta la disponibilidad de canchas, salas de estudio y laboratorios, y confirma tu reserva desde cualquier dispositivo.</source>
        <target>Check the availability of courts, study rooms and labs, and confirm your booking from any device.</target>
      </trans-unit>
      <trans-unit id="auth.login.highlightAvailability" datatype="html">
        <source>Disponibilidad en tiempo real</source>
        <target>Real-time availability</target>
      </trans-unit>
      <trans-unit id="auth.login.highlightSpaces" datatype="html">
        <source>Espacios deportivos y de estudio</source>
        <target>Sports and study spaces</target>
      </trans-unit>
      <trans-unit id="auth.login.title" datatype="html">
        <source>Inicia sesión</source>
        <target>Sign in</target>
      </trans-unit>
      <trans-unit id="auth.login.subtitle" datatype="html">
        <source>Usa las credenciales de tu universidad para continuar.</source>
        <target>Use your university credentials to continue.</target>
      </trans-unit>
      <trans-unit id="auth.login.identifierLabel" datatype="html">
        <source>Correo institucional o documento</source>
        <target>University email or ID</target>
      </trans-unit>
      <trans-unit id="auth.login.passwordLabel" datatype="html">
        <source>Contraseña</source>
        <target>Password</target>
      </trans-unit>
      <trans-unit id="auth.login.rememberMe" datatype="html">
        <source>No cerrar sesión</source>
        <target>Keep me signed in</target>
      </trans-unit>
      <trans-unit id="auth.login.forgotPassword" datatype="html">
        <source>¿Olvidaste tu contraseña?</source>
        <target>Forgot your password?</target>
      </trans-unit>
      <trans-unit id="auth.login.submit" datatype="html">
        <source>Iniciar sesión</source>
        <target>Sign in</target>
      </trans-unit>
      <trans-unit id="auth.login.alternativeSeparator" datatype="html">
        <source>o</source>
        <target>or</target>
      </trans-unit>
      <trans-unit id="auth.login.submitWithCard" datatype="html">
        <source>Entrar con el carné universitario</source>
        <target>Sign in with your student card</target>
      </trans-unit>
      <trans-unit id="auth.login.helpLabel" datatype="html">
        <source>Centro de ayuda</source>
        <target>Help centre</target>
      </trans-unit>
      <trans-unit id="auth.login.privacyLabel" datatype="html">
        <source>Política de privacidad</source>
        <target>Privacy policy</target>
      </trans-unit>
      <trans-unit id="auth.login.legal" datatype="html">
        <source>Todos los derechos reservados. Acceso exclusivo para la comunidad universitaria.</source>
        <target>All rights reserved. Access restricted to the university community.</target>
      </trans-unit>
      <trans-unit id="theme.switchToLight" datatype="html">
        <source>Cambiar al tema claro</source>
        <target>Switch to the light theme</target>
      </trans-unit>
      <trans-unit id="theme.switchToDark" datatype="html">
        <source>Cambiar al tema oscuro</source>
        <target>Switch to the dark theme</target>
      </trans-unit>
      <trans-unit id="i18n.languageSelector" datatype="html">
        <source>Idioma</source>
        <target>Language</target>
      </trans-unit>
    </body>
  </file>
</xliff>
